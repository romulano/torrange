<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        O tema é só a moldura: a interface inteira é a página. O que importa
        aqui é a cor de fundo ser a do site, para não haver um piscar branco
        entre a abertura da janela e o primeiro quadro da WebView.
    -->
    <style name="Tema.Torrange" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/fundo</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorBackground">@color/fundo</item>
    </style>
</resources>
