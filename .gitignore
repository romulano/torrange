# a interface dentro do APK e gerada a partir de src/renderer no build
android/app/src/main/assets/app/
# a chave de assinatura do APK: perde-la significa nao conseguir mais
# ATUALIZAR o aplicativo instalado (so reinstalar do zero)
android/chave/

*.log

# segredos locais (o token da conta nunca vai para o repositorio)
token.bin
instalacao.json

# pagina da especificacao da API salva localmente (referencia, nao fonte)
API do Aplicativo torrange.html
API do Aplicativo torrange_files/
